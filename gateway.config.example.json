{
  "host": "127.0.0.1",
  "port": 3800,
  "sessionIdleMinutes": 30,
  "instances": {
    "hello": {
      "module": "hello"
    },
    "file-tools": {
      "module": "files",
      "env": {
        "FILES_ROOTS": "D:/projects;D:/workspace"
      }
    },
    "mysql-alpha-tools": {
      "module": "mysql",
      "envFile": ".env.alpha"
    },
    "mongodb-alpha-tools": {
      "module": "mongodb",
      "envFile": ".env.alpha"
    },
    "tdengine-alpha-tools": {
      "module": "tdengine",
      "envFile": ".env.alpha"
    },
    "kafka-alpha-tools": {
      "module": "kafka",
      "envFile": ".env.alpha"
    },
    "mqtt-alpha-tools": {
      "module": "mqtt",
      "args": [
        "--host",
        "mqtt.example.com",
        "--port",
        "8883",
        "--username",
        "<user>",
        "--password",
        "<password>"
      ]
    },
    "outlook-tools": {
      "module": "outlook"
    }
  }
}