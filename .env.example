# ========== 選填：指定 .env 路徑（預設為執行目錄下的 .env） ==========
# ENV_FILE=.env

# ========== MySQL（必填） ==========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database
# query_mysql 預設最多回傳筆數（可用 maxRows 參數覆寫）
# MYSQL_MAX_ROWS=500
# query_mysql 執行超過此毫秒數即取消（KILL QUERY）
# MYSQL_QUERY_TIMEOUT_MS=60000
# 是否允許各類 MySQL 操作（true/false，預設 true）；false 的工具不會註冊（client 看不到）
# 同樣規則適用於 MONGO_*_OPERATION、TDENGINE_*_OPERATION
# MYSQL_QUERY_OPERATION=true
# MYSQL_INSERT_OPERATION=true
# MYSQL_UPDATE_OPERATION=true
# MYSQL_DELETE_OPERATION=true

# ========== SSH 通道（選填；多層 jump server 格式） ==========
# 以 JSON 陣列描述每一層，順序為「由外到內」
# 每一層可使用 password 或 privateKeyPath / privateKey
# SSH_JUMPS=[{"host":"jump-1.example.com","port":22,"user":"ubuntu","privateKeyPath":"D:/keys/jump1"},{"host":"jump-2.internal","port":22,"user":"ec2-user","privateKeyPath":"D:/keys/jump2"}]
# 可為不同服務指定不同 jump chain（未指定時 fallback 到 SSH_JUMPS）
# MYSQL_SSH_JUMPS=[{"host":"mysql-jump.example.com","port":22,"user":"ubuntu","privateKeyPath":"D:/keys/mysql-jump"}]
# TDENGINE_SSH_JUMPS=[{"host":"jump-1.example.com","port":22,"user":"ubuntu","privateKeyPath":"D:/keys/jump1"},{"host":"jump-2.internal","port":22,"user":"ec2-user","privateKeyPath":"D:/keys/jump2"}]
# MONGO_SSH_JUMPS=[{"host":"mongo-jump.example.com","port":22,"user":"ubuntu","privateKeyPath":"D:/keys/mongo-jump"}]
# KAFKA_SSH_JUMPS=[{"host":"jump-1.example.com","port":22,"user":"ubuntu","privateKeyPath":"D:/keys/jump1"},{"host":"jump-2.internal","port":22,"user":"ec2-user","privateKeyPath":"D:/keys/jump2"}]
# 啟用 SSH 時，MYSQL_HOST / KAFKA_HOST 會作為遠端目標位址

# ========== Kafka（選填，用於 servers/kafka.js） ==========
# 單一 broker（不建議用逗號填多個 IP，請改用 KAFKA_BROKERS）
# KAFKA_HOST=kafka-headless-service.default.svc.cluster.local
# KAFKA_PORT=9092
# 多個 broker（逗號分隔，port 可省略，預設 9092）
# KAFKA_BROKERS=10.10.112.155,10.10.112.158,10.10.193.132
# 多個 topic（逗號分隔）
# KAFKA_TOPICS=OC_EVENTS,OC_METRICS,OC_UPDATE
# K8s headless DNS 後綴（本機 SSH tunnel 時，對應 kafka-0 ~ kafka-N）
# KAFKA_BROKER_DNS_SUFFIX=kafka-headless-service.default.svc.cluster.local
# KAFKA_BROKER_NAME_PREFIX=kafka
# KAFKA_GROUP_ID=mcp-kafka-alpha
# KAFKA_SSL=false
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# ========== MQTT（選填，用於 servers/mqtt.js） ==========
# 命令列參數（--host、--port…）優先；未指定時才使用以下環境變數；--topics 與 MQTT_TOPICS 會合併
# MQTT_HOST=mqtt.example.com
# MQTT_PORT=8883              # 預設：TLS 為 8883，否則 1883
# MQTT_TOPICS=/events/#,/metrics/#
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=mcp-mqtt-alpha
# MQTT_TLS=true               # false 等同 --no-tls
# MQTT_CA_CERT=D:/certs/ca.pem
# MQTT_CLIENT_CERT=D:/certs/client.pem
# MQTT_CLIENT_KEY=D:/certs/client.key
# MQTT_REJECT_UNAUTHORIZED=false  # true 才驗證 broker 憑證（預設 false，維持既有行為）

# ========== Outlook（選填，用於 servers/outlook.js；Windows + 傳統版 Outlook） ==========
# OUTLOOK_POWERSHELL=powershell.exe
# OUTLOOK_TIMEOUT_MS=120000
# OUTLOOK_IDLE_MS=600000
# auto：純 ASCII 關鍵字走 Windows Search 索引（快，比對字首）；like：一律子字串比對（中文 / 標點一律用 like）
# OUTLOOK_SEARCH_MODE=auto
# OUTLOOK_FOLDER_CACHE_SECONDS=300
# OUTLOOK_MAX_BODY_CHARS=20000

# ========== MongoDB（選填，用於 servers/mongodb.js） ==========
# MONGO_HOST=127.0.0.1
# MONGO_PORT=27017
# MONGO_USER=your_user
# MONGO_PASSWORD=your_password
# MONGO_DATABASE=your_database
# MONGO_AUTH_SOURCE=your_auth_db  # 預設為 MONGO_DATABASE
# MONGO_AUTH_MECHANISM=SCRAM-SHA-256
# query_mongo 回傳 JSON 字元上限（超過時只回傳放得下的文件並標示 truncated）
# MONGO_MAX_RESPONSE_CHARS=100000
# query_mongo / list_mongo_collections 的伺服器端逾時（maxTimeMS；寫入不設限，避免中途中止只改一半）
# MONGO_TIMEOUT_MS=60000
# 是否允許各類 MongoDB 操作（true/false，預設 true）
# MONGO_QUERY_OPERATION=true
# MONGO_INSERT_OPERATION=true
# MONGO_UPDATE_OPERATION=true
# MONGO_DELETE_OPERATION=true
# MONGO_LIST_COLLECTIONS_OPERATION=true
# 若需經 SSH jump server 連 MongoDB，可搭配上方 SSH_JUMPS / MONGO_SSH_JUMPS 設定使用

# ========== TDengine REST API（選填，用於 servers/tdengine.js） ==========
# TDENGINE_HOST=127.0.0.1
# TDENGINE_PORT=6041
# TDENGINE_USER=root
# TDENGINE_PASSWORD=taosdata
# TDENGINE_TIMEOUT_MS=120000
# query_tdengine 預設最多回傳筆數（可用 maxRows 參數覆寫）
# TDENGINE_MAX_ROWS=500
# 是否允許各類 TDengine 操作（true/false，預設 true）
# TDENGINE_QUERY_OPERATION=true
# TDENGINE_INSERT_OPERATION=true
# TDENGINE_UPDATE_OPERATION=true
# TDENGINE_DELETE_OPERATION=true

# ========== HTTP（axios tools，選填） ==========
# 回應 body 超過此字元數會被截斷（dataTruncated: true），預設 100000
# HTTP_MAX_RESPONSE_CHARS=100000

# ========== 檔案讀取（選填，用於 servers/files.js） ==========
# 限制 readFile 只能讀取這些目錄（Windows 以 ; 分隔，其他系統以 : 分隔）；未設定時可讀取任何本機檔案
# FILES_ROOTS=D:/projects;D:/workspace
# readFile 的 maxBytes 上限
# FILES_MAX_BYTES=2000000
